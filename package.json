{
  "name": "swarmd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "bin": { "swarmd": "./swarmd" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "bun build --compile --outfile dist/swarmd src/subagent-cli.ts",
    "install:local": "bun run build:binary && mkdir -p \"$HOME/.config/swarmd\" && cp dist/swarmd \"$HOME/.config/swarmd/swarmd\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test --test-timeout=15000 dist/*.test.js",
    "test:binary": "node test/smoke-binary.mjs dist/swarmd",
    "start": "node dist/subagent-cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
